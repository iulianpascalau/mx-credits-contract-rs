{
    "name": "migration_test",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:owner": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user1": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                },
                "address:user2": {
                    "nonce": "0",
                    "balance": "100,000,000,000,000,000,000"
                }
            },
            "newAddresses": [
                {
                    "creatorAddress": "address:owner",
                    "creatorNonce": "0",
                    "newAddress": "sc:requests_contract"
                }
            ]
        },
        {
            "step": "scDeploy",
            "txId": "deploy",
            "tx": {
                "from": "address:owner",
                "contractCode": "mxsc:../scenarios/requests_contract/requests/requests.mxsc.json",
                "arguments": [
                    "100"
                ],
                "gasLimit": "60000000",
                "gasPrice": "1000000000"
            }
        },
        {
            "step": "scCall",
            "txId": "user1_add_requests",
            "tx": {
                "from": "address:user1",
                "to": "sc:requests_contract",
                "egldValue": "1,000,000,000,000,000,000",
                "function": "addRequests",
                "arguments": [
                    "0x01"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "txId": "user2_add_requests_1",
            "tx": {
                "from": "address:user2",
                "to": "sc:requests_contract",
                "egldValue": "1,000,000,000,000,000,000",
                "function": "addRequests",
                "arguments": [
                    "0x02"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "txId": "user2_add_requests_2",
            "tx": {
                "from": "address:user2",
                "to": "sc:requests_contract",
                "egldValue": "1,000,000,000,000,000,000",
                "function": "addRequests",
                "arguments": [
                    "0x02"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "txId": "check_user1",
            "tx": {
                "to": "sc:requests_contract",
                "function": "getRequests",
                "arguments": [
                    "0x01"
                ]
            },
            "expect": {
                "out": [
                    "100"
                ]
            }
        },
        {
            "step": "scQuery",
            "txId": "check_user2",
            "tx": {
                "to": "sc:requests_contract",
                "function": "getRequests",
                "arguments": [
                    "0x02"
                ]
            },
            "expect": {
                "out": [
                    "200"
                ]
            }
        },
        {
            "step": "checkState",
            "comment": "Snapshot storage before upgrade",
            "accounts": {
                "sc:requests_contract": {
                    "storage": "*"
                }
            }
        },
        {
            "step": "scDeploy",
            "txId": "upgrade",
            "comment": "Upgrade to new contract",
            "tx": {
                "from": "address:owner",
                "contractCode": "file:../output/credits.wasm",
                "upgrade": true,
                "to": "sc:requests_contract",
                "arguments": [
                    "100"
                ],
                "gasLimit": "60,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "status": "0"
            }
        },
        {
            "step": "setState",
            "comment": "Force code update: TODO: fix this in the framework and remove this step",
            "accounts": {
                "sc:requests_contract": {
                    "owner": "address:owner",
                    "code": "file:../output/credits.wasm",
                    "storage": {
                        "str:numCreditsPerEgld": "100",
                        "str:requests|u64:1": "100",
                        "str:requests|u64:2": "200"
                    }
                }
            }
        },
        {
            "step": "scQuery",
            "txId": "check_user1_after_upgrade",
            "tx": {
                "to": "sc:requests_contract",
                "function": "getCredits",
                "arguments": [
                    "0x01"
                ]
            },
            "expect": {
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "txId": "check_user2_after_upgrade",
            "tx": {
                "to": "sc:requests_contract",
                "function": "getCredits",
                "arguments": [
                    "0x02"
                ]
            },
            "expect": {
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "txId": "user1_add_credits",
            "tx": {
                "from": "address:user1",
                "to": "sc:requests_contract",
                "egldValue": "1,000,000,000,000,000,000",
                "function": "addCredits",
                "arguments": [
                    "0x01"
                ],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "txId": "check_user1_new_credits",
            "tx": {
                "to": "sc:requests_contract",
                "function": "getCredits",
                "arguments": [
                    "0x01"
                ]
            },
            "expect": {
                "out": [
                    "100"
                ]
            }
        },
        {
            "step": "scCall",
            "txId": "pause_before_migrate",
            "tx": {
                "from": "address:owner",
                "to": "sc:requests_contract",
                "function": "pause",
                "arguments": [],
                "gasLimit": "10,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "status": "0"
            }
        },
        {
            "step": "scCall",
            "txId": "migrate",
            "tx": {
                "from": "address:owner",
                "to": "sc:requests_contract",
                "function": "migrate",
                "arguments": [
                    "0x01",
                    "0x64"
                ],
                "gasLimit": "100,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "status": "0"
            }
        },
        {
            "step": "scQuery",
            "txId": "check_user1_migrated",
            "tx": {
                "to": "sc:requests_contract",
                "function": "getCredits",
                "arguments": [
                    "0x01"
                ]
            },
            "expect": {
                "out": [
                    "200"
                ]
            }
        },
        {
            "step": "scQuery",
            "txId": "check_user2_migrated",
            "tx": {
                "to": "sc:requests_contract",
                "function": "getCredits",
                "arguments": [
                    "0x02"
                ]
            },
            "expect": {
                "out": [
                    "200"
                ]
            }
        }
    ]
}